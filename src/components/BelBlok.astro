---
import { telHref } from '../config';
interface Props { titel?: string; tekst?: string; }
const {
  titel = 'Een gesprek is de beste start',
  tekst = 'Vertel ons over uw collectie. Vrijblijvend, zonder verkooppraatje — en wat u ons vertelt, blijft tussen ons.',
} = Astro.props;
---
<section class="sectie sectie--groen" aria-labelledby="belblok-titel">
  <div class="wrap belblok">
    <div>
      <h2 id="belblok-titel">{titel}</h2>
      <p class="intro">{tekst}</p>
    </div>
    <div class="belblok__acties">
      <a class="knop knop--groot" href={telHref}>Bel ons</a>
      <a class="knop knop--tweede" href="/contact/">Of plan een kennismaking</a>
    </div>
  </div>
</section>

<style>
  .belblok { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 56em) { .belblok { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  .belblok > div > :last-child { margin-bottom: 0; }
  .belblok__acties { display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; }
</style>
