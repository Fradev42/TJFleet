---
import { formulier, site, telHref, mailHref } from '../config';
---
{!formulier.actief ? (
  <div class="formulier-uit kaart">
    <p class="intro">Bel ons op <a href={telHref}>{site.telefoon.weergave}</a>, of stuur een e-mail naar <a href={mailHref}>{site.email}</a> met uw naam en telefoonnummer.</p>
    <p>We bellen u binnen één werkdag terug.</p>
  </div>
) : (
<form class="formulier" id="formulier" method="post" action={formulier.actie}>
  <p class="formulier__uitleg">Velden met <strong>(verplicht)</strong> moeten ingevuld zijn. De rest mag u leeg laten.</p>

  <p class="formulier__samenvatting" role="alert" tabindex="-1" hidden></p>

  <!-- Spambescherming: dit veld is onzichtbaar voor bezoekers; robots vullen het in. -->
  <div class="lokaas" aria-hidden="true">
    <label for="website">Laat dit veld leeg</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="veld">
    <label for="naam">Uw naam <span class="verplicht">(verplicht)</span></label>
    <input id="naam" name="naam" type="text" autocomplete="name" required maxlength="120" aria-describedby="naam-fout" />
    <p class="veld__fout" id="naam-fout" hidden></p>
  </div>

  <div class="veld">
    <label for="telefoon">Telefoonnummer <span class="verplicht">(verplicht)</span></label>
    <p class="hint" id="telefoon-hint">Wij bellen u terug op dit nummer.</p>
    <input id="telefoon" name="telefoon" type="tel" autocomplete="tel" inputmode="tel" required maxlength="40"
      pattern="[0-9 +.\-]{8,40}" title="Bijvoorbeeld 0470 12 34 56" aria-describedby="telefoon-hint telefoon-fout" />
    <p class="veld__fout" id="telefoon-fout" hidden></p>
  </div>

  <div class="veld">
    <label for="email">E-mailadres</label>
    <input id="email" name="email" type="email" autocomplete="email" maxlength="160" aria-describedby="email-fout" />
    <p class="veld__fout" id="email-fout" hidden></p>
  </div>

  <div class="veld">
    <label for="aantal">Aantal wagens in uw collectie</label>
    <select id="aantal" name="aantal_wagens">
      <option value="">Maak een keuze</option>
      <option value="1-3">1 tot 3</option>
      <option value="4-9">4 tot 9</option>
      <option value="10+">10 of meer</option>
    </select>
  </div>

  <div class="veld">
    <label for="moment">Wanneer bellen we u best?</label>
    <select id="moment" name="voorkeursmoment">
      <option value="">Geen voorkeur</option>
      <option value="voormiddag">In de voormiddag (9 tot 12 uur)</option>
      <option value="namiddag">In de namiddag (12 tot 18 uur)</option>
      <option value="zaterdag">Op zaterdag</option>
    </select>
  </div>

  <div class="veld">
    <label for="boodschap">Korte boodschap</label>
    <p class="hint" id="boodschap-hint">Bijvoorbeeld wat u graag wilt bespreken.</p>
    <textarea id="boodschap" name="boodschap" rows="5" maxlength="3000" aria-describedby="boodschap-hint"></textarea>
  </div>

  <p class="formulier__fout" role="alert" hidden>
    Het verzenden is niet gelukt. Probeer het opnieuw, of bel ons gerust op <a href={telHref}>{site.telefoon.weergave}</a>.
  </p>

  <button class="knop knop--groot" type="submit">Verstuur mijn aanvraag</button>
  <p class="formulier__privacy">Wij gebruiken uw gegevens alleen om u terug te bellen. Lees onze <a href="/privacy/">privacyverklaring</a>.</p>
</form>
)}

<script>
  // Met JavaScript: duidelijke foutmeldingen per veld en verzenden zonder de pagina te verlaten.
  // Zonder JavaScript post het formulier gewoon; de browser en de server controleren de velden.
  import { FOUTMELDINGEN, telefoonGeldig, emailGeldig } from '../lib/formulier-logica.js';

  const form = document.querySelector<HTMLFormElement>('form.formulier');
  if (form) {
    form.noValidate = true;
    const samenvatting = form.querySelector<HTMLElement>('.formulier__samenvatting')!;
    const fout = form.querySelector<HTMLElement>('.formulier__fout')!;
    const knop = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const veld = (naam: string) => form.querySelector<HTMLInputElement>(`[name="${naam}"]`);

    const toonFouten = (fouten: string[]) => {
      for (const naam of ['naam', 'telefoon', 'email']) {
        const invoer = veld(naam)!;
        const melding = document.getElementById(`${naam}-fout`)!;
        const heeftFout = fouten.includes(naam);
        invoer.setAttribute('aria-invalid', String(heeftFout));
        melding.hidden = !heeftFout;
        melding.textContent = heeftFout ? FOUTMELDINGEN[naam as keyof typeof FOUTMELDINGEN] : '';
      }
      samenvatting.hidden = fouten.length === 0;
      samenvatting.textContent = fouten.length === 1
        ? 'Eén veld is nog niet correct ingevuld. Kijk de melding bij dat veld na.'
        : `${fouten.length} velden zijn nog niet correct ingevuld. Kijk de meldingen bij die velden na.`;
      if (fouten.length) veld(fouten[0])?.focus();
    };

    const controleer = () => {
      const fouten: string[] = [];
      if (!veld('naam')!.value.trim()) fouten.push('naam');
      if (!telefoonGeldig(veld('telefoon')!.value.trim())) fouten.push('telefoon');
      const email = veld('email')!.value.trim();
      if (email && !emailGeldig(email)) fouten.push('email');
      return fouten;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      fout.hidden = true;
      const fouten = controleer();
      toonFouten(fouten);
      if (fouten.length) return;

      knop.disabled = true;
      knop.textContent = 'Bezig met verzenden…';
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          window.location.assign('/contact/bedankt/');
          return;
        }
        if (Array.isArray(data.fouten) && data.fouten.length) toonFouten(data.fouten);
        else fout.hidden = false;
      } catch {
        fout.hidden = false;
      }
      knop.disabled = false;
      knop.textContent = 'Verstuur mijn aanvraag';
    });
  }
</script>

<style>
  .formulier { display: grid; gap: 1.5rem; max-width: 38rem; }
  .formulier p { margin: 0; }
  .formulier__uitleg { color: var(--kleur-tekst-zacht); }
  .veld { display: flex; flex-direction: column; gap: 0.35rem; }
  label { font-weight: 650; }
  .verplicht { font-weight: 400; color: var(--kleur-accent-2); }
  .hint { font-size: 1rem; color: var(--kleur-tekst-zacht); }
  input, select, textarea {
    font: inherit;
    font-size: max(1rem, 18px);
    color: var(--kleur-tekst);
    background: var(--kleur-wit);
    border: 1.5px solid var(--kleur-lijn-sterk);
    border-radius: var(--radius);
    padding: 0.75rem 0.9rem;
    min-height: 3.25rem;
    width: 100%;
  }
  textarea { resize: vertical; min-height: 8rem; }
  input:hover, select:hover, textarea:hover { border-color: var(--kleur-accent); }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 3px solid var(--kleur-focus); outline-offset: 1px; border-color: var(--kleur-accent); }
  input[aria-invalid='true'] { border-color: var(--kleur-accent-2); border-width: 2px; }
  .veld__fout { font-weight: 600; color: var(--kleur-accent-2); }
  .veld__fout::before { content: '⚠ '; }
  .formulier__samenvatting, .formulier__fout { padding: 1rem 1.25rem; border-left: 4px solid var(--kleur-accent-2); background: #f6e9e7; }
  .formulier__samenvatting:focus { outline: none; }
  .formulier__privacy { font-size: 1rem; color: var(--kleur-tekst-zacht); }
  .formulier .knop { justify-self: start; }
  .formulier .knop:disabled { opacity: 0.8; cursor: wait; }
  @media (max-width: 47.99em) { .formulier .knop { justify-self: stretch; } }
  .lokaas { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .formulier-uit { max-width: 38rem; }
  .formulier-uit > :last-child { margin-bottom: 0; }
</style>
