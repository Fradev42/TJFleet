---
import { site, telHref, mailHref, vestigingRegels, menu } from '../config';
const jaar = new Date().getFullYear();
---
<footer class="sitefooter">
  <div class="wrap">
    <div class="sitefooter__raster">
      <div>
        <img class="sitefooter__logo" src="/logo/logo.svg" alt={site.logoAlt} width="196" height="52" loading="lazy" />
        <p>{site.baseline} in {site.regioTekst}.</p>
      </div>
      <div>
        <h2 class="sitefooter__kop">Contact</h2>
        <address>
          {site.naam}<br />
          {vestigingRegels.map((r) => <>{r}<br /></>)}
          <a href={telHref}>{site.telefoon.weergave}</a><br />
          <a href={mailHref}>{site.email}</a>
        </address>
      </div>
      <nav aria-label="Voettekst">
        <h2 class="sitefooter__kop">Pagina’s</h2>
        <ul>
          {menu.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          <li><a href="/werkgebied/">Werkgebied</a></li>
          <li><a href="/privacy/">Privacyverklaring</a></li>
        </ul>
      </nav>
    </div>
    <p class="sitefooter__klein">
      © {jaar} {site.naam} is een handelsnaam van {site.juridischeNaam} · Ondernemingsnummer {site.btwNummer} · <a href="/privacy/">Privacyverklaring</a> · Deze website gebruikt geen cookies.
    </p>
  </div>
</footer>

<style>
  .sitefooter {
    background: var(--kleur-achtergrond);
    color: var(--kleur-tekst);
    border-top: 1px solid var(--kleur-lijn);
    padding-block: 3.5rem 2rem;
    font-size: 1rem;
  }
  .sitefooter a { color: var(--kleur-accent); }
  .sitefooter a:hover { color: var(--kleur-accent-2); text-decoration-thickness: 2px; }
  .sitefooter__raster { display: grid; gap: 2rem; margin-bottom: 2.5rem; }
  @media (min-width: 48em) { .sitefooter__raster { grid-template-columns: 1.3fr 1fr 1fr; } }
  .sitefooter__logo { height: 3.25rem; width: auto; max-width: 100%; object-fit: contain; margin-bottom: 1rem; }
  .sitefooter__naam { font-family: var(--font-titel); font-size: 1.4rem; color: var(--kleur-accent); margin-bottom: 0.4rem; }
  .sitefooter__kop { font-family: var(--font-tekst); font-size: 0.85rem; font-weight: 650; letter-spacing: 0.12em; text-transform: uppercase; color: var(--kleur-accent-2); margin-bottom: 0.75rem; }
  address { font-style: normal; line-height: 1.9; }
  ul { list-style: none; padding: 0; margin: 0; }
  li a { display: inline-block; padding-block: 0.3rem; }
  .sitefooter__klein { border-top: 1px solid var(--kleur-lijn); color: var(--kleur-tekst-zacht); padding-top: 1.5rem; margin: 0; max-width: none; font-size: 0.95rem; }
</style>
