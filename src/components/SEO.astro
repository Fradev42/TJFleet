---
import { site, team } from '../config';

interface Props {
  /** Onderwerp van de pagina; de merknaam wordt er automatisch achter gezet. Samen liefst ± 60 tekens. */
  title: string;
  description: string;
  /** Pad van de Open Graph-afbeelding in /public. */
  ogImage?: string;
  /** 'article' voor gidsen, anders 'website'. */
  ogType?: 'website' | 'article';
  /** Publicatie- en wijzigingsdatum (enkel bij ogType 'article'). */
  artikel?: { gepubliceerd: string; bijgewerkt: string };
  noindex?: boolean;
}
const { title, description, ogImage = '/og-image.jpg', ogType = 'website', artikel, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogUrl = new URL(ogImage, Astro.site ?? site.url).href;
const volledigeTitel = `${title} | ${site.naam}`;

// Helpt Google om de sitenaam correct te tonen in de zoekresultaten.
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.naam,
  url: `${site.url}/`,
  inLanguage: 'nl-BE',
  publisher: { '@id': `${site.url}/#bedrijf` },
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#bedrijf`,
  name: site.naam,
  legalName: site.juridischeNaam,
  description: 'Onafhankelijk beheer en verzorging van oldtimers en exclusieve wagens: onderhoud, reiniging met wax of coating, keuring, verzekering, transport en een volledig dossier per wagen.',
  url: site.url,
  telephone: site.telefoon.link,
  email: site.email,
  vatID: site.btwNummer,
  image: new URL('/og-image.jpg', Astro.site ?? site.url).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.adres.straat,
    postalCode: site.adres.postcode,
    addressLocality: site.adres.gemeente,
    addressCountry: site.adres.landCode,
  },
  // Tweede vestiging, zonder straat zolang die niet bekend is.
  location: site.vestigingen.slice(1).map((v) => ({
    '@type': 'Place',
    name: `${site.naam} ${v.gemeente}`,
    address: { '@type': 'PostalAddress', postalCode: v.postcode, addressLocality: v.gemeente, addressRegion: v.provincie, addressCountry: site.adres.landCode },
  })),
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: site.openingsuren.dagen,
    opens: site.openingsuren.van,
    closes: site.openingsuren.tot,
  }],
  areaServed: site.regio.map((r) => ({ '@type': 'AdministrativeArea', name: r })),
  knowsLanguage: ['nl', 'fr', 'en'],
  employee: team.map((p) => ({ '@type': 'Person', name: p.naam, sameAs: [p.linkedin] })),
};
---
<title>{volledigeTitel}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={ogType} />
{artikel && <meta property="article:published_time" content={artikel.gepubliceerd} />}
{artikel && <meta property="article:modified_time" content={artikel.bijgewerkt} />}
<meta property="og:locale" content="nl_BE" />
<meta property="og:site_name" content={site.naam} />
<meta property="og:title" content={volledigeTitel} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.naam}: ${site.baseline}`} />
<meta name="twitter:card" content="summary_large_image" />

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
{Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(website)} />}
