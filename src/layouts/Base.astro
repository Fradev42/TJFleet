---
import '@fontsource/libre-caslon-text/400.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { plausible, cookiesActief } from '../config';
// Preload van de Latijnse lettertypebestanden: voorkomt verspringende tekst bij het laden.
import sansWoff2 from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';
import serifWoff2 from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
---
<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1F3A2E" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href={sansWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <SEO title={title} description={description} noindex={noindex} />
    {plausible.ingeschakeld && (
      <script is:inline defer data-domain={plausible.domein} src={plausible.script}></script>
    )}
  </head>
  <body>
    <a class="skiplink" href="#inhoud">Naar de inhoud</a>
    {cookiesActief && <CookieBanner />}
    <Header />
    <main id="inhoud" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <MobileBar />
  </body>
</html>
