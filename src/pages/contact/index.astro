---
import Base from '../../layouts/Base.astro';
import Contactformulier from '../../components/Contactformulier.astro';
import { site, telHref, mailHref, vestigingRegels } from '../../config';
---
<Base
  title="Contact en kennismaking"
  description="Bel ons of vraag een vrijblijvend kennismakingsgesprek aan. Wij komen langs in Gent, Brugge, Kortrijk, Knokke en heel Oost- en West-Vlaanderen."
>
  <header class="paginakop">
    <div class="wrap">
      <span class="bovenschrift">Contact</span>
      <h1>Laten we kennismaken</h1>
      <p class="intro">Bellen is het eenvoudigst. Liever dat wij u bellen? Laat ons weten hoe we u kunnen bereiken.</p>

      <div class="contactlijnen">
        <a class="contactlijn" href={telHref}>
          <span class="contactlijn__label">Telefoon</span>
          <span class="contactlijn__waarde">{site.telefoon.weergave}</span>
        </a>
        <a class="contactlijn" href={mailHref}>
          <span class="contactlijn__label">E-mail</span>
          <span class="contactlijn__waarde contactlijn__waarde--mail">{site.email.split('@')[0]}@<wbr />{site.email.split('@')[1]}</span>
        </a>
      </div>
    </div>
  </header>

  <section class="sectie" aria-labelledby="formulier-titel">
    <div class="wrap contact">
      <div>
        <h2 id="formulier-titel">Kennismaking aanvragen</h2>
        <Contactformulier />
      </div>
      <aside class="contact__info" aria-label="Adres en bereikbaarheid">
        <div class="kaart">
          <h2 class="contact__kop">Vestigingen</h2>
          <address>
            {site.juridischeNaam}<br />
            {vestigingRegels.map((r) => <>{r}<br /></>)}
          </address>
          <p class="klein">Wij komen bij u langs, bij u thuis of in uw stalling.</p>

          <h2 class="contact__kop">Bereikbaarheid</h2>
          <ul>
            {site.bereikbaarheid.map((r) => <li>{r}</li>)}
          </ul>

          <h2 class="contact__kop">Waar wij werken</h2>
          <p>Heel Oost- en West-Vlaanderen, van Gent, Aalst en Oudenaarde tot Brugge, Knokke-Heist en Kortrijk. <a href="/werkgebied/">Bekijk ons werkgebied</a>.</p>

          <h2 class="contact__kop">Gegevens</h2>
          <p>Ondernemingsnummer {site.btwNummer}</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contactlijnen { display: grid; gap: 1rem; margin-top: 2rem; }
  @media (min-width: 48em) { .contactlijnen { grid-template-columns: repeat(2, minmax(0, max-content)); gap: 1.5rem; } }
  .contactlijn {
    display: flex; flex-direction: column;
    padding: 1rem 1.5rem;
    background: var(--kleur-wit);
    border: 2px solid var(--kleur-accent);
    border-radius: var(--radius);
    text-decoration: none;
    min-width: 0;
  }
  .contactlijn:hover { box-shadow: 0 0 0 3px var(--kleur-lijn); }
  .contactlijn:hover .contactlijn__waarde { text-decoration: underline; text-decoration-thickness: 2px; }
  .contactlijn__label { font-size: 0.85rem; font-weight: 650; letter-spacing: 0.1em; text-transform: uppercase; color: var(--kleur-accent-2); }
  .contactlijn__waarde { font-family: var(--font-titel); font-size: clamp(1.6rem, 4vw, 2.3rem); line-height: 1.25; color: var(--kleur-accent); overflow-wrap: anywhere; }
  .contactlijn__waarde--mail { font-size: clamp(1.3rem, 3vw, 1.8rem); overflow-wrap: normal; }

  .contact { display: grid; gap: 3rem; }
  @media (min-width: 56em) { .contact { grid-template-columns: 1.5fr 1fr; gap: 4rem; align-items: start; } }
  .contact__kop { font-family: var(--font-tekst); font-size: 0.9rem; font-weight: 650; letter-spacing: 0.1em; text-transform: uppercase; color: var(--kleur-tekst); margin: 1.75rem 0 0.5rem; }
  .contact__kop:first-child { margin-top: 0; }
  address { font-style: normal; margin-bottom: 0.75rem; }
  .klein { font-size: 0.95rem; color: var(--kleur-tekst-zacht); }
  ul { padding-left: 1.1rem; }
  li { margin-bottom: 0.35rem; }
</style>
