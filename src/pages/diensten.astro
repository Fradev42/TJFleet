---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BelBlok from '../components/BelBlok.astro';
import werkplaats from '../assets/images/werkplaats.jpg';

const diensten = [
  {
    id: 'onderhoud',
    titel: 'Onderhoud en keuring op tijd',
    links: [{ href: '/gids/oldtimerkeuring/', label: 'Gids: de oldtimerkeuring' }],
    tekst: [
      'Wij houden de kalender van elke wagen bij: onderhoud, oldtimerkeuring en de andere vervaldata. U krijgt tijdig bericht in onze app; wij maken de afspraken en regelen het vervoer.',
      'Zo staat geen enkele wagen te lang stil, en mist u geen keuring, ook niet met tien wagens en tien verschillende data.',
    ],
  },
  {
    id: 'verzorging',
    titel: 'Verzorging en altijd rijklaar',
    tekst: [
      'Wij kuisen uw wagens grondig, vanbinnen en vanbuiten, en beschermen de lak naar uw wens met een wax of een coating. Zo blijven ze er op hun best uitzien en zijn ze beschermd tegen vocht, vuil en uv.',
      'Daarnaast zorgen wij dat elke wagen te allen tijde rijklaar staat: de batterij geladen, de banden op spanning en de vloeistoffen op peil. Wilt u vertrekken, dan kan dat meteen.',
    ],
  },
  {
    id: 'restauratie',
    titel: 'Restauratie via vaste specialisten',
    tekst: [
      'Mechanisch werk en restauraties doen wij niet zelf. Wij kiezen met u de juiste specialist uit een vaste kring die we goed kennen: mecaniciens, carrosseriers, bekleders en restaurateurs.',
      'Voor grotere werken vragen we vergelijkbare offertes op, vergelijken ze voor u en volgen de werken op tot de wagen terug bij u staat.',
    ],
  },
  {
    id: 'papieren',
    titel: 'Verzekering, inschrijving en LEZ',
    links: [
      { href: '/gids/oldtimer-inschrijven/', label: 'Gids: een oldtimer inschrijven' },
      { href: '/gids/oldtimer-lez-gent-antwerpen-brussel/', label: 'Gids: oldtimers in de LEZ' },
      { href: '/gids/oldtimer-verzekeren/', label: 'Gids: een oldtimer verzekeren' },
    ],
    tekst: [
      'Wij zorgen dat de papieren van elke wagen in orde zijn: de inschrijving en nummerplaat, voor een oldtimer ook de inschrijving met O-plaat, en de registratie voor de lage-emissiezones van Gent, Antwerpen en Brussel.',
      'Wij verkopen zelf geen verzekeringen, maar bekijken met u en uw makelaar of de verzekerde waarde en de dekking nog kloppen. Veranderen de regels, dan hoort u het van ons.',
    ],
  },
  {
    id: 'transport',
    titel: 'Transport naar garage, rally en concours',
    tekst: [
      'Uw wagens blijven gewoon waar ze nu staan: bij u thuis of in uw eigen stalling. Moet een wagen naar de garage, de keuring of de restaurateur, dan regelen wij het transport heen en terug.',
      'Voor een rally, concours d’elegance of rit met vrienden regelen we, samen met een vaste transportpartner, vervoer in een gesloten trailer en maken we de wagen vooraf rijklaar.',
    ],
  },
  {
    id: 'dossier',
    titel: 'Een volledig dossier per wagen',
    links: [{ href: '/gids/oldtimer-laten-taxeren/', label: 'Gids: een oldtimer laten taxeren' }],
    tekst: [
      'Per wagen bewaren we de historiek, facturen, foto’s, documenten en sleutels, overzichtelijk en veilig. U kijkt het dossier op elk moment in via onze app, en bij verkoop, expertise of schade is alles meteen terug te vinden.',
      'We volgen ook de waarde van elke wagen op, zodat uw verzekering en uw nalatenschap steeds kloppen.',
    ],
  },
];

const vragen = [
  {
    vraag: 'Werken jullie enkel met oldtimers?',
    antwoord: 'Nee. Wij beheren en verzorgen zowel oldtimers en youngtimers als recente, exclusieve wagens. Veel collecties zijn gemengd, en elke wagen krijgt de zorg die past bij zijn leeftijd en gebruik.',
  },
  {
    vraag: 'Kuisen jullie de wagens ook?',
    antwoord: 'Ja. Wij kuisen uw wagens vanbinnen en vanbuiten, en beschermen de lak naar uw wens met een wax of een coating. Hoe vaak, spreken we per wagen met u af.',
  },
  {
    vraag: 'Hebben jullie een eigen garage of stalling?',
    antwoord: 'Nee. Mechanisch werk en restauraties laten we uitvoeren door vaste specialisten, en we hebben geen eigen stalling. Uw wagens blijven bij u thuis of in uw eigen stalling; kuisen en verzorgen doen we zelf.',
  },
  {
    vraag: 'Verdienen jullie aan de garages die jullie inschakelen?',
    antwoord: 'Nee. Wij nemen geen commissie van partners en verkopen geen wagens. U betaalt alleen ons, zodat ons advies onafhankelijk blijft.',
  },
  {
    vraag: 'Hoe geef ik toestemming voor een herstelling?',
    antwoord: 'U krijgt een melding in onze app, met de uitleg en de offertes erbij, en keurt goed met één tik. Liever eerst overleggen? Dan bellen we u.',
  },
  {
    vraag: 'Wie ziet de gegevens van mijn collectie?',
    antwoord: 'Alleen u en ons team. Wij delen niets met derden zonder uw akkoord, spreken niet over klanten en tonen geen wagens of adressen.',
  },
  {
    vraag: 'In welke regio werken jullie?',
    antwoord: 'In heel Oost- en West-Vlaanderen, van Gent en Aalst tot Brugge, Knokke-Heist en Kortrijk. We komen bij u langs.',
  },
  {
    vraag: 'Wat kost het?',
    antwoord: 'Dat hangt af van het aantal wagens en wat u uit handen wilt geven. Na een vrijblijvend kennismakingsgesprek krijgt u een voorstel op maat.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: vragen.map((v) => ({
    '@type': 'Question',
    name: v.vraag,
    acceptedAnswer: { '@type': 'Answer', text: v.antwoord },
  })),
};
---
<Base
  title="Oldtimers en exclusieve wagens: onderhoud en verzorging"
  description="Onderhoud en keuring op tijd, kuisen met wax of coating, restauratie via specialisten, verzekering, LEZ en transport. Voor oldtimers en recente wagens."
>
  <header class="paginakop">
    <div class="wrap">
      <span class="bovenschrift">Diensten</span>
      <h1>Alles rond uw wagens, op één plek geregeld</h1>
      <p class="intro">Voor oldtimers, youngtimers en exclusieve wagens van vandaag. Van onderhoud en keuring tot kuisen, wax of coating, restauratie, verzekering en transport. U kiest zelf wat u uit handen geeft: één dienst of het volledige beheer van uw collectie. Wij werken altijd in uw naam en in uw belang.</p>
    </div>
  </header>

  <section class="sectie" aria-label="Onze diensten">
    <div class="wrap raster raster--2">
      {diensten.map((d) => (
        <article class="kaart" id={d.id} aria-labelledby={`${d.id}-titel`}>
          <h2 id={`${d.id}-titel`} class="dienst__titel">{d.titel}</h2>
          {d.tekst.map((t) => <p>{t}</p>)}
          {d.links && (
            <ul class="dienst__links">
              {d.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          )}
        </article>
      ))}
      <aside class="kaart niet-doen" aria-labelledby="niet-doen-titel">
        <h2 id="niet-doen-titel" class="dienst__titel">Wat wij niet doen</h2>
        <p>Wij hebben geen eigen garage en geen eigen stalling, verkopen geen wagens en nemen geen commissie van de specialisten die we inschakelen. Zo staan we altijd aan uw kant.</p>
      </aside>
    </div>
  </section>

  <section class="sectie sectie--vlak" aria-labelledby="prijs-titel">
    <div class="wrap raster raster--2 prijs">
      <div class="foto">
        <Image src={werkplaats} alt="Een mecanicien stelt met een moersleutel de motor van een klassieke wagen af, in een werkplaats met gereedschap aan de wand" widths={[480, 800, 1200]} sizes="(min-width: 48em) 50vw, 100vw" />
      </div>
      <div>
        <h2 id="prijs-titel">Op maat van uw collectie</h2>
        <p class="nota">Prijs na een vrijblijvend gesprek.</p>
        <p>Geen twee collecties zijn gelijk. Daarom maken we na een eerste kennismaking een voorstel dat past bij het aantal wagens, hun toestand en wat u zelf wilt blijven doen.</p>
        <p><a class="knop" href="/contact/">Plan een kennismaking</a></p>
      </div>
    </div>
  </section>

  <section class="sectie" aria-labelledby="faq-titel">
    <div class="wrap">
      <h2 id="faq-titel">Veelgestelde vragen</h2>
      <dl class="faq">
        {vragen.map((v) => (
          <div class="faq__item">
            <dt>{v.vraag}</dt>
            <dd>{v.antwoord}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <BelBlok />
</Base>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .dienst__titel { font-size: clamp(1.45rem, 2.6vw, 1.8rem); }
  .prijs { align-items: center; }
  .dienst__links { list-style: none; padding: 0; margin: 0; }
  .dienst__links a { display: inline-block; padding-block: 0.35rem; font-weight: 600; }
  .niet-doen { background: transparent; border-style: dashed; border-color: var(--kleur-lijn-sterk); }
  .faq { margin: 2rem 0 0; max-width: 50rem; display: grid; gap: 0; }
  .faq__item { padding-block: 1.25rem; border-top: 1px solid var(--kleur-lijn); }
  .faq__item:last-child { border-bottom: 1px solid var(--kleur-lijn); }
  .faq dt { font-family: var(--font-titel); font-size: 1.25rem; color: var(--kleur-accent); margin-bottom: 0.4rem; }
  .faq dd { margin: 0; }
</style>
