---
import Base from '../../layouts/Base.astro';
import BelBlok from '../../components/BelBlok.astro';
import { gidsen } from '../../gidsen';

---
<Base
  title="Gidsen voor oldtimereigenaars | APEX Classic Car Care"
  description="Heldere gidsen voor oldtimereigenaars in België: LEZ, inschrijven, keuring, verzekeren, taxeren, restauratie, onderhoud, events en overdracht."
>
  <header class="paginakop">
    <div class="wrap">
      <span class="bovenschrift">Gidsen</span>
      <h1>Gidsen voor oldtimereigenaars</h1>
      <p class="intro">De regels rond oldtimers veranderen geregeld. In deze gidsen zetten we het belangrijkste op een rij, in gewone taal. Voor onze klanten volgen we dit allemaal op.</p>
    </div>
  </header>

  <section class="sectie" aria-label="Alle gidsen">
    <div class="wrap">
      <ul class="gidsen">
        {gidsen.map((g) => (
          <li>
            <a href={g.href}>
              <span class="gidsen__titel">{g.titel}</span>
              <span>{g.tekst}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <BelBlok />
</Base>

<style>
  .gidsen { list-style: none; padding: 0; margin: 0; max-width: none; display: grid; gap: 1.25rem; }
  @media (min-width: 48em) { .gidsen { grid-template-columns: repeat(2, 1fr); } }
  .gidsen a {
    display: flex; flex-direction: column; gap: 0.5rem; height: 100%;
    padding: 1.5rem 1.75rem; background: var(--kleur-wit);
    border: 1px solid var(--kleur-lijn); border-top: 3px solid var(--kleur-accent); border-radius: var(--radius);
    color: var(--kleur-tekst); text-decoration: none;
  }
  .gidsen a:hover { box-shadow: 0 0 0 3px var(--kleur-lijn); color: var(--kleur-tekst); }
  .gidsen a:hover .gidsen__titel { text-decoration: underline; text-decoration-thickness: 2px; }
  .gidsen__titel { font-family: var(--font-titel); font-size: 1.4rem; line-height: 1.25; color: var(--kleur-accent); }
  .gidsen__titel::after { content: ' →'; }
</style>
