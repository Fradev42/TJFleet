---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BelBlok from '../components/BelBlok.astro';
import { site, telHref } from '../config';
import hero from '../assets/images/hero.jpg';
---
<Base
  title="Home"
  description={`Onafhankelijk beheer van uw collectie klassieke wagens in ${site.regio.join(' en ')}. Eén vast aanspreekpunt voor stalling, onderhoud, keuring, verzekering en transport.`}
>
  <section class="hero" aria-labelledby="hero-titel">
    <div class="hero__beeld">
      <Image
        src={hero}
        alt="Een donkergroene klassieke coupé in een rustige garage met witte bakstenen muren, verlicht door een hoog raam"
        widths={[640, 960, 1280, 1920, 2400].filter((w) => w <= hero.width)}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero__tekst">
      <div class="wrap">
        <span class="bovenschrift">{site.baseline} · {site.regio.join(' & ')}</span>
        <h1 id="hero-titel">Uw collectie in goede handen</h1>
        <p class="hero__sub">Wij beheren uw klassieke wagens, u geniet ervan.</p>
        <div class="knoppen">
          <a class="knop knop--groot" href={telHref}>Bel ons</a>
          <a class="knop knop--groot knop--tweede" href="/contact/">Plan een kennismaking</a>
        </div>
      </div>
    </div>
  </section>

  <section class="sectie" aria-labelledby="beloften-titel">
    <div class="wrap">
      <h2 id="beloften-titel" class="visueel-verborgen">Waarom eigenaars voor ons kiezen</h2>
      <div class="raster raster--3">
        <div class="belofte">
          <h3>Eén aanspreekpunt</h3>
          <p>U hebt één vaste contactpersoon die uw wagens kent. Eén telefoontje volstaat; wij regelen de rest met garages, keuring en verzekeraar.</p>
        </div>
        <div class="belofte">
          <h3>Onafhankelijk advies</h3>
          <p>Wij verkopen geen wagens en krijgen geen commissie op herstellingen. Wij staan aan uw kant en vergelijken offertes in uw belang.</p>
        </div>
        <div class="belofte">
          <h3>Discretie gegarandeerd</h3>
          <p>Uw collectie, uw adres en uw gegevens blijven vertrouwelijk. Wij spreken nooit over klanten en tonen geen wagens zonder uw akkoord.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sectie sectie--vlak" aria-labelledby="werkwijze-titel">
    <div class="wrap">
      <span class="bovenschrift">Werkwijze</span>
      <h2 id="werkwijze-titel">Zo gaan we te werk</h2>
      <p class="intro">Rustig en stap voor stap. U beslist, wij voeren uit en houden u op de hoogte.</p>
      <ol class="stappen stappen--rij" style="margin-top: 2.5rem;">
        <li>
          <h3>Kennismaking</h3>
          <p>We komen langs bij u thuis of in de stalling en luisteren naar wat u van uw collectie verwacht.</p>
        </li>
        <li>
          <h3>Inventaris en plan</h3>
          <p>Per wagen brengen we de toestand, de papieren en de planning in kaart.</p>
        </li>
        <li>
          <h3>Vaste opvolging</h3>
          <p>Eén contactpersoon volgt alles op, en in onze app ziet u altijd hoe uw wagens ervoor staan.</p>
        </li>
      </ol>
      <p style="margin-top: 2.5rem;"><a class="knop knop--tweede" href="/werkwijze/">Lees meer over onze werkwijze</a></p>
    </div>
  </section>

  <section class="sectie" aria-labelledby="app-titel">
    <div class="wrap app-blok">
      <div>
        <span class="bovenschrift">Onze app</span>
        <h2 id="app-titel">Altijd op de hoogte, zonder erom te moeten vragen</h2>
        <p class="intro">In onze app ziet u op elk moment hoe uw wagens ervoor staan. En is uw toestemming nodig voor een herstelling of een aankoop, dan keurt u goed met één tik.</p>
        <p><a class="knop knop--tweede" href="/werkwijze/#app">Bekijk een voorbeeld van de app</a></p>
      </div>
      <ul class="app-blok__punten">
        <li><strong>Overzicht per wagen</strong>: toestand, planning en kosten.</li>
        <li><strong>Toestemming in één tik</strong>, met de uitleg en de offertes erbij.</li>
        <li><strong>Het volledige dossier</strong>: historiek, facturen, foto’s en documenten.</li>
      </ul>
    </div>
  </section>

  <hr class="lijn" />

  <section class="sectie" aria-labelledby="getuigenis-titel">
    <div class="wrap">
      <h2 id="getuigenis-titel" class="bovenschrift">Een eigenaar aan het woord</h2>
      <figure class="citaat">
        <blockquote>
          <p>“[[GETUIGENIS — twee à drie zinnen van een klant, bijvoorbeeld over rust, vertrouwen en het gemak van één aanspreekpunt.]]”</p>
        </blockquote>
        <figcaption>[[Voornaam of initialen]], eigenaar van een collectie van [[aantal]] wagens, [[regio]]</figcaption>
      </figure>
    </div>
  </section>

  <BelBlok />
</Base>

<style>
  .app-blok { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 56em) { .app-blok { grid-template-columns: 1.3fr 1fr; gap: 4rem; } }
  .app-blok > div > :last-child { margin-bottom: 0; }
  .app-blok__punten { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .app-blok__punten li { padding: 1rem 1.25rem; background: var(--kleur-wit); border: 1px solid var(--kleur-lijn); border-left: 3px solid var(--kleur-accent); border-radius: var(--radius); }
  .hero { position: relative; background: var(--kleur-accent); color: #fff; overflow: hidden; }
  .hero__beeld { position: absolute; inset: 0; }
  .hero__beeld :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero__beeld :global(img) { object-position: 70% center; }
  /* Donkere laag links voor leesbare tekst; rechts blijft de foto vrij. */
  .hero__beeld::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(21,40,31,0.9) 0%, rgba(21,40,31,0.82) 35%, rgba(21,40,31,0.35) 58%, rgba(21,40,31,0) 78%);
  }
  .hero__tekst { position: relative; padding-block: clamp(5rem, 14vw, 10rem); }
  .hero h1 { color: #fff; max-width: 14ch; }
  .hero .bovenschrift { color: #e9dcc7; }
  .hero__sub { font-size: clamp(1.25rem, 2.4vw, 1.6rem); line-height: 1.45; max-width: 34ch; margin-bottom: 2.25rem; color: #f7f4ee; }
  /* Smartphone en staande tablet: foto bovenaan, tekst eronder op groen. */
  @media (max-width: 63.99em) {
    .hero__beeld { position: relative; aspect-ratio: 16 / 10; }
    .hero__beeld::after { display: none; }
    .hero__tekst { padding-block: 2.5rem 3rem; }
  }
  @media (max-width: 47.99em) {
    .hero__beeld { aspect-ratio: 4 / 3; }
    .hero__beeld :global(img) { object-position: 75% center; }
    .hero .knop { width: 100%; }
  }
</style>
