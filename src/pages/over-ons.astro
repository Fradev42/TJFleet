---
import Base from '../layouts/Base.astro';
import BelBlok from '../components/BelBlok.astro';
import { site, partners } from '../config';
---
<Base
  title="Over ons: onafhankelijk, aan uw kant"
  description="Wij werken onafhankelijk en aan de kant van de eigenaar: geen eigen garage, geen verkoop, geen commissie. Vanuit Zwijnaarde en Sint-Eloois-Winkel."
>
  <header class="paginakop">
    <div class="wrap">
      <span class="bovenschrift">Over ons</span>
      <h1>Liefhebbers, met oog voor detail</h1>
      <p class="intro">Wij zijn een kleine, persoonlijke zaak met thuisbases in Zwijnaarde en Sint-Eloois-Winkel. Bewust klein, zodat u altijd met dezelfde mensen spreekt.</p>
      <p>{site.naam} is een handelsnaam van {site.juridischeNaam}, ondernemingsnummer {site.btwNummer}.</p>
    </div>
  </header>

  <section class="sectie sectie--vlak" aria-labelledby="verhaal-titel">
    <div class="wrap raster raster--2">
      <div>
        <h2 id="verhaal-titel">Waarom we begonnen</h2>
        <p>Wie meerdere mooie wagens heeft, merkt vaak dat er na een tijd meer tijd naar regelen gaat dan naar rijden: afspraken bij de garage, keuringen, papieren, verzekeringen en transport.</p>
        <p>Daarom begonnen we {site.naam}: zodat u weer kunt doen waarvoor u die wagens ooit kocht. Er gewoon van genieten.</p>
      </div>
      <div>
        <h2>Waarom wij onafhankelijk werken</h2>
        <p>Wij verkopen geen wagens, hebben geen eigen garage en nemen geen commissie van partners. Wij worden enkel door u betaald.</p>
        <p>Zo kunnen we eerlijk adviseren: een herstelling uitstellen als dat kan, een tweede offerte vragen als de eerste te hoog lijkt, of een specialist aanraden die beter past bij uw wagen.</p>
      </div>
    </div>
  </section>

  <section class="sectie" aria-labelledby="partners-titel">
    <div class="wrap">
      <h2 id="partners-titel">Ons netwerk van specialisten</h2>
      <p class="intro">We werken met een beperkte kring van specialisten die we persoonlijk kennen en van wie we het werk zelf opvolgen.</p>
      <p>Het gaat om mecaniciens, carrossiers, bekleders, restaurateurs en een vaste transportpartner. Welke specialist we inschakelen, kiezen we per wagen, samen met u.</p>
      {partners.length > 0 && (
        <ul class="partners">
          {partners.map((p) => <li><img class="partners__logo" src={p.logo} alt={p.naam} loading="lazy" /><span>{p.soort}</span></li>)}
        </ul>
      )}
    </div>
  </section>

  <BelBlok />
</Base>

<style>
  .partners { list-style: none; padding: 0; margin: 2rem 0 0; max-width: none; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); }
  .partners li { display: flex; flex-direction: column; gap: 0.5rem; text-align: center; font-size: 0.95rem; }
  .partners__logo { height: 5.5rem; width: 100%; object-fit: contain; }
</style>
